# Server Configuration
PORT=5000

# Client URL allowed by CORS (* for development)
CLIENT_URL=*

# (Optional) Admin API Key for viewing stored messages via GET /api/messages
ADMIN_SECRET_KEY=my_portfolio_secret_key_2026

# ───── Supabase (Cloud PostgreSQL Database) ─────
# Get these from your Supabase Dashboard: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ───── (Optional) Nodemailer Configuration ─────
# Leave SMTP_PASS blank if you only want to save messages to Supabase/SQLite
SMTP_SERVICE=gmail
SMTP_USER=bagdwaladitya17@gmail.com
SMTP_PASS=
NOTIFICATION_RECEIVER=bagdwaladitya17@gmail.com
